---
// "Use the … form" box for the documentation guides (forms in src/data/site.ts).
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import Todo from "./ui/Todo.astro";
import { forms, site } from "../data/site";

interface Props {
    form: keyof typeof forms;
}

const copy = {
    profile: { name: "profile form", text: "Add or update your profile, photo and projects with one form.", repo: "marc_people" },
    news: { name: "news form", text: "Send a news article or a vacancy, with photos, or correct a published article.", repo: "marc_news" },
} satisfies Record<keyof typeof forms, { name: string; text: string; repo: string }>;

const { form } = Astro.props;
const href = forms[form];
const { name, text, repo } = copy[form];
const linkSubject = `${name[0].toUpperCase()}${name.slice(1)} link`;
---

<div class="form-link surface-tonal not-prose">
    <span class="form-link__icon"><Icon name="material-symbols:assignment-outline" /></span>
    <div class="flex-1">
        <p class="form-link__title">No GitHub account needed</p>
        <p class="mt-1 text-[0.9375rem]">
            {
                href ? (
                    text
                ) : (
                    <>
                        Ask the MARC website maintainers for the {name} link at{" "}
                        <a href={`mailto:${site.email}?subject=${encodeURIComponent(linkSubject)}`} class="text-primary underline">
                            {site.email}
                        </a>
                        .
                    </>
                )
            }
        </p>
    </div>
    {
        href && (
            <Button href={href} external icon="material-symbols:arrow-outward">
                Open the {name}
            </Button>
        )
    }
</div>
{!href && <Todo>Set forms.{form} in src/data/site.ts to the form's share link ({repo}/google-form/README.md, step 7).</Todo>}

<style>
    .form-link {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.25rem;
        margin: 1.5rem 0;
        padding: 1.25rem 1.5rem;
    }
    .form-link__icon {
        display: grid;
        place-items: center;
        flex: none;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--color-base-100);
        color: var(--color-primary);
    }
    .form-link__icon :global(svg) {
        width: 1.375rem;
        height: 1.375rem;
    }
    .form-link__title {
        font-family: var(--font-head);
        font-weight: 600;
        color: var(--color-heading);
    }
</style>
