---
// Person tile (spec §9.9): round photo, name, role — the layout Google uses on team pages.
// Emails are never printed (decision D12). No photo → neutral avatar icon.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./ui/Icon.astro";

interface Props {
    name: string;
    role: string;
    href: string;
    photo?: ImageMetadata;
    affiliation?: string;
    headingLevel?: "h3" | "h4";
}
const { name, role, href, photo, affiliation, headingLevel: H = "h3" } = Astro.props;
---

<a href={href} class="person">
    <span class="person__photo">
        {
            photo ? (
                <Image src={photo} alt="" widths={[160, 320]} sizes="160px" class="person__img" />
            ) : (
                <span class="person__placeholder">
                    <Icon name="material-symbols:person-outline" />
                </span>
            )
        }
    </span>
    <H class="person__name">{name}</H>
    <p class="person__role">{role}</p>
    {affiliation && <p class="person__aff">{affiliation}</p>}
</a>

<style>
    .person {
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        padding: 1.5rem 1rem;
        border-radius: var(--radius-card);
        text-align: center;
        transition: background-color var(--t-fast) var(--ease-brand);
    }
    .person:hover {
        background: var(--color-soft);
    }
    .person__photo {
        display: block;
        width: 132px;
        height: 132px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--color-soft-2);
    }
    .person :global(.person__img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 15%;
    }
    .person__placeholder {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        color: var(--color-muted);
    }
    .person__placeholder :global(svg) {
        width: 56px;
        height: 56px;
    }
    .person__name {
        margin-top: 1rem;
        font-size: 1.0625rem;
        line-height: 1.35;
    }
    .person:hover .person__name {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .person__role {
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: var(--color-body);
    }
    .person__aff {
        margin-top: 0.125rem;
        font-size: 0.8125rem;
        color: var(--color-muted);
    }
</style>
