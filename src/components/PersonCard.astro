---
// Person tile (spec §9.9): round photo, name, role — the layout Google uses on team pages.
// Emails are never printed (decision D12). No photo → neutral avatar icon.
// Two kinds: a whole-card link to a profile page (`href`), or, with `links`, a card with round
// buttons to the person's own pages; its name links to `href` when there is one (`external`: a page
// on another site, such as their portfolio, opened in a new tab).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./ui/Icon.astro";
import ProfileLinks from "./ProfileLinks.astro";
import type { ProfileLinksData } from "../lib/people";

interface Props {
    name: string;
    role: string;
    href?: string;
    external?: boolean;
    photo?: ImageMetadata;
    affiliation?: string;
    links?: ProfileLinksData;
    headingLevel?: "h3" | "h4";
}
const { name, role, href, external = false, photo, affiliation, links, headingLevel: H = "h3" } = Astro.props;
const asLink = Boolean(href) && !links;
const Root = asLink ? "a" : "article";
---

<Root href={asLink ? href : undefined} class:list={["person", asLink && "person--link"]}>
    <span class="person__photo">
        {
            photo ? (
                <Image src={photo} alt="" widths={[160, 320]} sizes="160px" class="person__img" />
            ) : (
                <span class="person__placeholder">
                    <Icon name="material-symbols:person-outline" />
                </span>
            )
        }
    </span>
    <H class="person__name">
        {
            !asLink && href ? (
                <a href={href} class="person__name-link" target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
                    {name}
                    {external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
            ) : (
                name
            )
        }
    </H>
    <p class="person__role">{role}</p>
    {affiliation && <p class="person__aff">{affiliation}</p>}
    {links && <ProfileLinks name={name} links={links} class="person__links" />}
</Root>

<style>
    .person {
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        padding: 1.5rem 1rem;
        border-radius: var(--radius-card);
        text-align: center;
        transition: background-color var(--t-fast) var(--ease-brand);
    }
    .person--link:hover {
        background: var(--color-soft);
    }
    .person__photo {
        display: block;
        width: 132px;
        height: 132px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--color-soft-2);
    }
    .person :global(.person__img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 15%;
    }
    .person__placeholder {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        color: var(--color-muted);
    }
    .person__placeholder :global(svg) {
        width: 56px;
        height: 56px;
    }
    .person__name {
        margin-top: 1rem;
        font-size: 1.0625rem;
        line-height: 1.35;
        text-wrap: balance;
    }
    .person--link:hover .person__name,
    .person__name-link:hover {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .person__role {
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: var(--color-body);
    }
    .person__aff {
        margin-top: 0.125rem;
        font-size: 0.8125rem;
        color: var(--color-muted);
        text-wrap: balance;
    }
    /* Buttons sit at the bottom so rows of cards line up whatever the text length. */
    .person :global(.person__links) {
        margin-top: auto;
        padding-top: 1rem;
    }
</style>
