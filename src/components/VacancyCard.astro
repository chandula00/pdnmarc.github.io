---
// One open vacancy on /vacancies: a marc_news article with `vacancy: true` (src/lib/vacancies.ts).
import { Image } from "astro:assets";
import Icon from "./ui/Icon.astro";
import Button from "./ui/Button.astro";
import Tag from "./ui/Tag.astro";
import { closesAt, formatDeadline, type NewsItem } from "../lib/vacancies";

interface Props {
    item: NewsItem;
}
const { item } = Astro.props;
const { title, short, date, cover, deadline, apply } = item.data;
const href = `/news/${item.id}/`;
const external = !!apply && /^https?:/.test(apply);
---

<li class="vacancy card-surface" data-closes={deadline ? closesAt(deadline) : undefined}>
    {
        cover && (
            <a href={href} class="vacancy__media" tabindex="-1" aria-hidden="true">
                <Image src={cover} alt="" widths={[320, 480, 640]} sizes="(max-width: 768px) 100vw, 260px" class="vacancy__img" />
            </a>
        )
    }
    <div class="vacancy__body">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
            <Tag variant="live" icon="material-symbols:work-outline">Open</Tag>
            <span>
                Posted <time datetime={date.toISOString().slice(0, 10)}>
                    {date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
                </time>
            </span>
        </p>
        <h3 class="text-h3 mt-3">
            <a href={href} class="hover:text-primary hover:underline">{title}</a>
        </h3>
        <p class="mt-2">{short}</p>
        <p class="vacancy__deadline">
            <Icon name="material-symbols:event-outline" />
            {
                deadline ? (
                    <span>
                        Apply by <time datetime={deadline.toISOString().slice(0, 10)}>{formatDeadline(deadline)}</time>
                    </span>
                ) : (
                    <span>No closing date given</span>
                )
            }
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
            {
                apply && (
                    <Button href={apply} external={external} icon={external ? "material-symbols:arrow-outward" : undefined} iconLeading={external ? undefined : "material-symbols:mail-outline"}>
                        Apply<span class="sr-only"> for {title}</span>
                    </Button>
                )
            }
            <Button href={href} variant={apply ? "outline" : "primary"} icon="material-symbols:arrow-forward">
                Read details<span class="sr-only"> on {title}</span>
            </Button>
        </div>
    </div>
</li>

<style>
    .vacancy {
        display: grid;
        overflow: hidden;
    }
    @media (min-width: 768px) {
        .vacancy:has(.vacancy__media) {
            grid-template-columns: 260px 1fr;
        }
    }
    .vacancy__media {
        display: block;
        aspect-ratio: 16 / 9;
        background: var(--color-soft-2);
    }
    @media (min-width: 768px) {
        .vacancy__media {
            aspect-ratio: auto;
        }
    }
    .vacancy :global(.vacancy__img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .vacancy__body {
        padding: clamp(1.25rem, 3vw, 2rem);
    }
    .vacancy__deadline {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
        font-weight: 600;
        color: var(--color-heading);
    }
    .vacancy__deadline :global(svg) {
        width: 1.25rem;
        height: 1.25rem;
        color: var(--color-primary);
        flex: none;
    }
</style>
