---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/ui/Prose.astro";
import Icon from "../../components/ui/Icon.astro";
import Button from "../../components/ui/Button.astro";
import { closesAt, formatDeadline, isOpen } from "../../lib/vacancies";

export async function getStaticPaths() {
    const news = await getCollection("news");
    return news.map((item) => ({
        params: { slug: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const isoDate = item.data.date.toISOString().slice(0, 10);
const { vacancy, deadline, apply } = item.data;
const applyExternal = !!apply && /^https?:/.test(apply);
---

<BaseLayout
    title={item.data.title}
    description={item.data.short}
    width="narrow"
    ogType="article"
    breadcrumbs={[{ label: "News", href: "/news/" }, { label: item.data.title }]}
    jsonLd={{
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        headline: item.data.title,
        datePublished: isoDate,
        description: item.data.short,
        publisher: { "@type": "ResearchOrganization", name: "Multidisciplinary AI Research Centre" },
    }}
>
    <article>
        <header class="mb-10">
            <p class="flex items-center gap-2 text-sm font-semibold text-muted">
                <Icon name="material-symbols:calendar-today-outline" class="h-4 w-4" />
                <time datetime={isoDate}>
                    {item.data.date.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" })}
                </time>
            </p>
            <h1 class="text-page-title mt-4">{item.data.title}</h1>
            <p class="text-lede mt-6 border-l-4 border-primary pl-5">{item.data.short}</p>
            {
                vacancy && (
                    <div
                        class="vacancy-notice surface-tonal"
                        data-closes={deadline ? closesAt(deadline) : undefined}
                        data-closed={isOpen(item) ? undefined : ""}
                    >
                        <p class="flex items-start gap-2 font-semibold text-heading">
                            <Icon name="material-symbols:event-outline" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
                            {deadline ? (
                                <span>
                                    <span class="when-open">Applications close on </span>
                                    <span class="when-closed">Applications closed on </span>
                                    <time datetime={deadline.toISOString().slice(0, 10)}>{formatDeadline(deadline)}</time>
                                </span>
                            ) : (
                                <span>No closing date given</span>
                            )}
                        </p>
                        <div class="when-open mt-4 flex flex-wrap gap-3">
                            {apply && (
                                <Button href={apply} external={applyExternal} iconLeading={applyExternal ? undefined : "material-symbols:mail-outline"} icon={applyExternal ? "material-symbols:arrow-outward" : undefined}>
                                    Apply
                                </Button>
                            )}
                            <Button href="/vacancies/" variant="outline">All vacancies</Button>
                        </div>
                        <p class="when-closed mt-2 text-sm">
                            This vacancy is closed. See the <a href="/vacancies/" class="text-primary underline">current vacancies</a>.
                        </p>
                    </div>
                )
            }
        </header>

        {
            item.data.cover && (
                <div class="mb-12 overflow-hidden rounded-[var(--radius-panel)] border border-line shadow-md">
                    <Image
                        src={item.data.cover}
                        alt=""
                        widths={[640, 900, 1280]}
                        sizes="(max-width: 960px) 100vw, 900px"
                        class="h-auto w-full object-cover"
                        loading="eager"
                        fetchpriority="high"
                    />
                </div>
            )
        }

        <Prose>
            <Content />
        </Prose>

        <a href="/news/" class="link-arrow mt-14">
            All news <Icon name="material-symbols:arrow-forward" />
        </a>
    </article>
</BaseLayout>

<script>
    import "../../scripts/deadlines";
</script>

<style>
    .vacancy-notice {
        margin-top: 2rem;
        padding: 1.25rem 1.5rem;
    }
    .vacancy-notice:not([data-closed]) .when-closed,
    .vacancy-notice[data-closed] .when-open {
        display: none;
    }
</style>
