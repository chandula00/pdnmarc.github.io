---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/ui/Icon.astro";
import Tag from "../../components/ui/Tag.astro";

const byDateDesc = (a: { date: string | Date }, b: { date: string | Date }) =>
    new Date(b.date).getTime() - new Date(a.date).getTime();

const articles = (await getCollection("news")).sort((a, b) => byDateDesc(a.data, b.data));
const social = (await getCollection("social_news")).sort((a, b) => byDateDesc(a.data, b.data));

const sourceIcon: Record<string, string> = {
    Facebook: "mdi:facebook",
    LinkedIn: "mdi:linkedin",
    Twitter: "mdi:twitter",
    Web: "material-symbols:language",
};
const fmt = (d: string | Date, opts: Intl.DateTimeFormatOptions) => new Date(d).toLocaleDateString("en-GB", opts);
---

<BaseLayout
    title="News"
    description="News, milestones and activity from the Multidisciplinary AI Research Centre, University of Peradeniya."
    breadcrumbs={[{ label: "News" }]}
    header={{
        eyebrow: "Latest News",
        title: "Research in Motion",
        subtitle:
            "The latest developments, research activities, events, achievements, collaborations and milestones from the Multidisciplinary AI Research Centre.",
    }}
>
    <section aria-labelledby="stories">
        <div class="mb-8 flex items-center gap-4">
            <h2 id="stories" class="text-h3 shrink-0">Featured stories</h2>
            <div class="divider-soft"></div>
        </div>
        <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 nav:grid-cols-3 lg:gap-8">
            {
                articles.map((item) => (
                    <li>
                        <a href={`/news/${item.id}/`} class="news-card group card-surface surface-hover">
                            <div class="news-card__media">
                                {item.data.cover ? (
                                    <Image
                                        src={item.data.cover}
                                        alt=""
                                        widths={[400, 640, 800]}
                                        sizes="(max-width: 768px) 100vw, (max-width: 1080px) 50vw, 400px"
                                        class="news-card__img"
                                    />
                                ) : (
                                    <div class="grid h-full place-items-center text-muted">
                                        <Icon name="material-symbols:newspaper" class="h-12 w-12 opacity-40" />
                                    </div>
                                )}
                            </div>
                            <div class="flex flex-grow flex-col p-6">
                                <p class="flex flex-wrap items-center gap-3">
                                    {item.data.vacancy && <Tag icon="material-symbols:work-outline">Vacancy</Tag>}
                                    <time datetime={item.data.date.toISOString().slice(0, 10)} class="text-xs font-bold uppercase tracking-wider text-muted">
                                        {fmt(item.data.date, { day: "numeric", month: "long", year: "numeric" })}
                                    </time>
                                </p>
                                <h3 class="text-h4 mt-2 transition-colors group-hover:text-primary">{item.data.title}</h3>
                                <p class="mt-3 line-clamp-3 text-[0.95rem]">{item.data.short}</p>
                                <span class="link-arrow mt-auto pt-5">
                                    Read story <Icon name="material-symbols:arrow-forward" />
                                </span>
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    {
        social.length > 0 && (
            <section class="mx-auto mt-20 max-w-4xl lg:mt-28" aria-labelledby="social">
                <div class="mb-8 text-center">
                    <p class="eyebrow eyebrow--center">Social feed</p>
                    <h2 id="social" class="text-h3 mt-3">Latest activity</h2>
                    <p class="mt-2 text-muted">Updates from MARC's official channels.</p>
                </div>
                <ul class="flex flex-col gap-4">
                    {social.map((item) => (
                        <li>
                            <a
                                href={item.data.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group card-surface surface-hover flex items-center gap-5 p-4 md:p-5"
                            >
                                <div class="hidden h-20 w-20 shrink-0 flex-col items-center justify-center rounded-2xl bg-soft text-center md:flex">
                                    <span class="font-head text-2xl font-extrabold text-primary">{new Date(item.data.date).getDate()}</span>
                                    <span class="text-xs font-bold uppercase text-muted">{fmt(item.data.date, { month: "short" })}</span>
                                </div>
                                <div class="min-w-0">
                                    <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-heading">
                                        <Icon name={sourceIcon[item.data.source] ?? "material-symbols:language"} class="h-4 w-4" />
                                        {item.data.source}
                                        <span class="font-normal normal-case tracking-normal text-muted md:hidden">
                                            · {fmt(item.data.date, { day: "numeric", month: "short", year: "numeric" })}
                                        </span>
                                    </p>
                                    <h3 class="text-h4 mt-1 transition-colors group-hover:text-primary">{item.data.title}</h3>
                                    <p class="mt-1 inline-flex items-center gap-1 text-sm text-muted">
                                        View original post <Icon name="material-symbols:arrow-outward" class="h-4 w-4" />
                                        <span class="sr-only"> (opens in a new tab)</span>
                                    </p>
                                </div>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        )
    }
</BaseLayout>

<style>
    .news-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }
    .news-card__media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--color-soft-2);
    }
    .news-card :global(.news-card__img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--t-slow) var(--ease-out-expo);
    }
    .news-card:hover :global(.news-card__img) {
        transform: scale(1.055);
    }
</style>
