---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/ui/Prose.astro";
import Tag from "../../components/ui/Tag.astro";
import Icon from "../../components/ui/Icon.astro";
import PublicationItem from "../../components/PublicationItem.astro";
import defaultAvatar from "../../assets/avatar_default.svg";
import { publicationsForProject, projectLinkMap, groupByYear, normKey } from "../../lib/publications";
import { getResearchAreas } from "../../lib/research";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Team entries are matched to people profiles by email. Anything that doesn't resolve
// renders as plain text, never as a dead "#" link (fixes B7).
const people = await getCollection("people");
const byEmail = new Map(people.map((p) => [p.data.email, p]));
const resolve = (ref: string) => {
    const person = byEmail.get(ref);
    if (!person && ref.includes("@")) console.warn(`[projects/${project.id}] team email "${ref}" does not match a people profile`);
    // Never print an unmatched email address (decision D12); plain names are shown as given.
    return { ref, person, label: person?.data.name ?? (ref.includes("@") ? "Profile not yet published" : ref) };
};
const supervisors = project.data.supervisors.map(resolve);
const members = project.data.projectMembers.map(resolve);

// Papers listed under this project in the publications sheet (see src/lib/publications.ts).
const projectPublications = await publicationsForProject(project);
const pubGroups = groupByYear(projectPublications);
const links = await projectLinkMap();
const areaPage = getResearchAreas().find((a) => a.title === project.data.researchArea);
---

<BaseLayout
    title={project.data.project}
    description={`${project.data.project} — a ${project.data.researchArea} project at the Multidisciplinary AI Research Centre, University of Peradeniya.`}
    breadcrumbs={[{ label: "Projects", href: "/projects/" }, { label: project.data.project }]}
>
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="space-y-12 lg:col-span-8">
            <header>
                <div class="mb-5 flex flex-wrap items-center gap-2">
                    <Tag variant="ink">{project.data.researchArea}</Tag>
                    {project.data.researchPillars.map((pillar) => <Tag variant="outline">{pillar}</Tag>)}
                </div>
                <h1 class="text-page-title">{project.data.project}</h1>
            </header>

            {
                project.data.coverImage && (
                    <div class="overflow-hidden rounded-[var(--radius-panel)] border border-line shadow-md">
                        <Image
                            src={project.data.coverImage}
                            alt=""
                            widths={[640, 960, 1280]}
                            sizes="(max-width: 1024px) 100vw, 860px"
                            class="h-auto w-full object-cover"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </div>
                )
            }

            <Prose>
                <Content />
            </Prose>

            {
                projectPublications.length > 0 && (
                    <section id="publications" aria-labelledby="publications-title">
                        <h2 id="publications-title" class="text-h2">
                            Publications
                        </h2>
                        <p class="mt-1 text-muted">
                            {projectPublications.length} {projectPublications.length === 1 ? "paper" : "papers"} from this project
                        </p>
                        {pubGroups.map((g) => (
                            <div class="mt-8">
                                <h3 class="border-b border-line pb-2 text-h4">{g.label}</h3>
                                <ol>
                                    {g.items.map((pub) => (
                                        <PublicationItem pub={pub} links={links} headingLevel="h4" hideProject={normKey(project.id)} />
                                    ))}
                                </ol>
                            </div>
                        ))}
                        <a href="/publications/" class="link-arrow mt-6">
                            All publications <Icon name="material-symbols:arrow-forward" />
                        </a>
                    </section>
                )
            }
        </div>

        <aside class="lg:col-span-4" aria-label="Project details">
            <div class="space-y-6 lg:sticky lg:top-24">
            <div class="card-surface p-6">
                <h2 class="text-h4">About this project</h2>
                <dl class="mt-4 grid gap-4 text-[0.9375rem]">
                    <div>
                        <dt class="text-sm text-muted">Research area</dt>
                        <dd class="mt-0.5">
                            {areaPage ? (
                                <a href={areaPage.url} class="text-primary hover:underline">{project.data.researchArea}</a>
                            ) : (
                                project.data.researchArea
                            )}
                        </dd>
                    </div>
                    {projectPublications.length > 0 && (
                        <div>
                            <dt class="text-sm text-muted">Publications</dt>
                            <dd class="mt-0.5">
                                <a href="#publications" class="text-primary hover:underline">
                                    {projectPublications.length} {projectPublications.length === 1 ? "paper" : "papers"}
                                </a>
                            </dd>
                        </div>
                    )}
                </dl>
            </div>
            {(supervisors.length > 0 || members.length > 0) && (
            <div class="card-surface p-6">
                <h2 class="text-h4 flex items-center gap-2">
                    <Icon name="material-symbols:group-outline" class="h-5 w-5 text-primary" />
                    Project team
                </h2>

                {
                    supervisors.length > 0 && (
                        <div class="mt-6">
                            <h3 class="mb-3 text-xs font-bold uppercase tracking-wider text-muted">Supervisors</h3>
                            <ul class="space-y-1">
                                {supervisors.map(({ person, label }) => (
                                    <li>
                                        {person ? (
                                            <a href={`/people/${person.id}/`} class="team-row group">
                                                <Image src={person.data.photo ?? defaultAvatar} alt="" width={80} height={80} class="team-row__avatar h-10 w-10" />
                                                <span>
                                                    <span class="block font-semibold text-heading group-hover:text-primary">{label}</span>
                                                    <span class="block text-xs text-muted">{person.data.post}</span>
                                                </span>
                                            </a>
                                        ) : (
                                            <span class="team-row">
                                                <Image src={defaultAvatar} alt="" width={80} height={80} class="team-row__avatar h-10 w-10" />
                                                <span class="font-semibold text-heading">{label}</span>
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )
                }

                {
                    members.length > 0 && (
                        <div class="mt-6 border-t border-line pt-6">
                            <h3 class="mb-3 text-xs font-bold uppercase tracking-wider text-muted">Researchers</h3>
                            <ul class="space-y-1">
                                {members.map(({ person, label }) => (
                                    <li>
                                        {person ? (
                                            <a href={`/people/${person.id}/`} class="team-row group">
                                                <Image src={person.data.photo ?? defaultAvatar} alt="" width={64} height={64} class="team-row__avatar h-8 w-8" />
                                                <span class="truncate font-medium text-heading group-hover:text-primary">{label}</span>
                                            </a>
                                        ) : (
                                            <span class="team-row">
                                                <Image src={defaultAvatar} alt="" width={64} height={64} class="team-row__avatar h-8 w-8" />
                                                <span class="truncate font-medium text-heading">{label}</span>
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )
                }
            </div>
            )}
            </div>
        </aside>
    </div>
</BaseLayout>

<style>
    .team-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-inline: -0.5rem;
        padding: 0.5rem;
        border-radius: 12px;
        font-size: 0.92rem;
        line-height: 1.35;
        min-width: 0;
    }
    a.team-row {
        transition: background-color var(--t-fast);
    }
    a.team-row:hover {
        background: var(--color-soft);
    }
    .team-row :global(.team-row__avatar) {
        flex: none;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 0 0 1px var(--color-line);
        background: var(--color-soft-2);
    }
</style>
