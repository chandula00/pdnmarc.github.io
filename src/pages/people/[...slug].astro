---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/ui/Prose.astro";
import Tag from "../../components/ui/Tag.astro";
import Icon from "../../components/ui/Icon.astro";
import PublicationItem from "../../components/PublicationItem.astro";
import defaultAvatar from "../../assets/avatar_default.svg";
import { publicationsForPerson, projectLinkMap } from "../../lib/publications";
import { isOnProject, isPast } from "../../lib/people";

export async function getStaticPaths() {
    const people = await getCollection("people");
    return people.map((person) => ({
        params: { slug: person.id },
        props: { person },
    }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Emails (primary and otherEmails) are the join key for projects, but are never shown (decision D12).
const projects = await getCollection("projects");
const personProjects = projects.filter((project) => isOnProject(person, project));

// Matched by email (original sheet) or by name / otherNames in the author list (src/lib/people.ts).
const personPublications = await publicationsForPerson(person);
const links = await projectLinkMap();

const hasBio = Boolean(person.body?.trim());
const past = isPast(person);
const centre = { "@type": "ResearchOrganization", name: "Multidisciplinary AI Research Centre" };
---

<BaseLayout
    title={person.data.name}
    description={`${person.data.name} — ${past ? "former " : ""}${person.data.post} at the Multidisciplinary AI Research Centre, University of Peradeniya.`}
    breadcrumbs={[{ label: "People", href: "/people/" }, { label: person.data.name }]}
    ogType="profile"
    jsonLd={{
        "@context": "https://schema.org",
        "@type": "Person",
        name: person.data.name,
        ...(past ? { alumniOf: centre } : { jobTitle: person.data.post, affiliation: centre }),
    }}
>
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-14">
        <aside class="lg:col-span-4">
            <div class="card-surface flex flex-col items-center p-8 text-center lg:sticky lg:top-24">
                <div class="h-44 w-44 overflow-hidden rounded-full bg-soft-2">
                    {
                        person.data.photo ? (
                            <Image
                                src={person.data.photo}
                                alt={`Photograph of ${person.data.name}`}
                                widths={[176, 352]}
                                sizes="176px"
                                class="h-full w-full object-cover object-[center_15%]"
                                loading="eager"
                            />
                        ) : (
                            <div class="grid h-full place-items-center">
                                <Image src={defaultAvatar} alt="" width={120} height={120} class="w-1/2 opacity-55" />
                            </div>
                        )
                    }
                </div>
                <h1 class="text-h3 mt-5">{person.data.name}</h1>
                <div class="mt-3 flex flex-wrap justify-center gap-2">
                    <Tag variant={person.data.post === "Director" ? "red" : "default"}>{person.data.post}</Tag>
                    {past && <Tag variant="outline">Past member</Tag>}
                </div>
                {
                    past && person.data.currentPosition && (
                        <p class="mt-4 text-sm">
                            <span class="text-muted">Now: </span>
                            {person.data.currentPosition}
                        </p>
                    )
                }
            </div>
        </aside>

        <div class="space-y-14 lg:col-span-8">
            {
                hasBio && (
                    <section aria-labelledby="bio">
                        <h2 id="bio" class="text-h3 mb-5">Biography</h2>
                        <Prose>
                            <Content />
                        </Prose>
                    </section>
                )
            }

            {
                personProjects.length > 0 && (
                    <section aria-labelledby="projects">
                        <h2 id="projects" class="text-h3 mb-6 flex items-center gap-3">
                            Associated projects
                            <span class="badge badge-neutral">{personProjects.length}</span>
                        </h2>
                        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            {personProjects.map((p) => (
                                <li>
                                    <a href={`/projects/${p.id}/`} class="group card-surface surface-hover flex h-full flex-col p-6">
                                        <span class="text-xs font-bold uppercase tracking-wider text-muted">{p.data.researchArea}</span>
                                        <h3 class="text-h4 mt-2 transition-colors group-hover:text-primary">{p.data.project}</h3>
                                        <span class="link-arrow mt-auto pt-5">
                                            View project <Icon name="material-symbols:arrow-forward" />
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }

            {
                personPublications.length > 0 && (
                    <section aria-labelledby="publications">
                        <h2 id="publications" class="text-h3 mb-6 flex items-center gap-3">
                            Publications
                            <span class="badge badge-neutral">{personPublications.length}</span>
                        </h2>
                        <ol>
                            {personPublications.map((pub) => (
                                <PublicationItem pub={pub} links={links} showYear />
                            ))}
                        </ol>
                    </section>
                )
            }
        </div>
    </div>
</BaseLayout>
