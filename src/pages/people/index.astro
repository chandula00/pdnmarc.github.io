---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonCard from "../../components/PersonCard.astro";
import Tag from "../../components/ui/Tag.astro";
import { isPast } from "../../lib/people";

const everyone = await getCollection("people");
// Current members are grouped by role; past members (`status: past`) get their own section last.
const people = everyone.filter((p) => !isPast(p));

// Fixed group order (spec §7.6). Every post lands in a group; unknown posts fall
// into "Team" instead of being dropped (fixes B1).
const GROUPS = [
    { id: "director", title: "Director", tag: "Leadership", posts: ["Director"] },
    { id: "deputy-directors", title: "Deputy Directors", tag: "Portfolios", posts: ["Deputy Director"] },
    { id: "members", title: "Members", tag: "Academic staff", posts: ["Member"] },
    { id: "advisors", title: "Advisors", tag: "Advisory", posts: ["Advisor"] },
    {
        id: "research-staff",
        title: "Engineers, Research Assistants & Coordinators",
        tag: "Research staff",
        posts: ["Project Coordinator", "Research Engineer", "Research Assistant", "Intern"],
    },
    { id: "volunteers", title: "Volunteers", tag: "Volunteers", posts: ["Volunteer"] },
];
const known = new Set(GROUPS.flatMap((g) => g.posts));
const byName = (a: (typeof people)[number], b: (typeof people)[number]) => a.data.name.localeCompare(b.data.name);

const groups = [
    ...GROUPS.map((g) => ({
        ...g,
        people: people
            .filter((p) => g.posts.includes(p.data.post))
            .sort((a, b) => g.posts.indexOf(a.data.post) - g.posts.indexOf(b.data.post) || byName(a, b)),
    })),
    {
        id: "team",
        title: "Team",
        tag: "MARC",
        posts: [],
        people: people.filter((p) => !known.has(p.data.post)).sort(byName),
    },
    {
        id: "past-members",
        title: "Past members",
        tag: "Alumni",
        posts: [],
        people: everyone.filter(isPast).sort(byName),
    },
].filter((g) => g.people.length > 0);
---

<BaseLayout
    title="People"
    description="The researchers, engineers and staff of the Multidisciplinary AI Research Centre, University of Peradeniya."
    breadcrumbs={[{ label: "People" }]}
    header={{
        eyebrow: "Our Researchers",
        title: "A Multidisciplinary Community of Researchers and Innovators",
        subtitle:
            "Academics, engineers and research assistants from Engineering, Science, Agriculture, Medicine and Management, working together across MARC's research areas.",
    }}
>
    <div class="space-y-16 lg:space-y-20">
        {
            groups.map((g) => (
                <section id={g.id} aria-labelledby={`${g.id}-title`}>
                    <div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-2">
                        <h2 id={`${g.id}-title`} class="text-h3">
                            {g.title}
                        </h2>
                        <Tag variant={g.id === "director" ? "red" : "default"}>{g.tag}</Tag>
                        <span class="text-sm text-muted">
                            {g.people.length} {g.people.length === 1 ? "person" : "people"}
                        </span>
                        <div class="divider-soft hidden min-w-12 flex-1 sm:block" />
                    </div>
                    <ul class="grid grid-cols-1 gap-5 min-[481px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
                        {g.people.map((person) => (
                            <li>
                                <PersonCard
                                    name={person.data.name}
                                    role={person.data.post}
                                    href={`/people/${person.id}/`}
                                    photo={person.data.photo}
                                    affiliation={isPast(person) && person.data.currentPosition ? `Now: ${person.data.currentPosition}` : undefined}
                                />
                            </li>
                        ))}
                    </ul>
                </section>
            ))
        }
    </div>
</BaseLayout>
