---
// About MARC (spec §7.2). Copy comes from src/data/site.ts (sourced from the official
// MARC site / uop.lk mockup). Missing items are dev-only TODOs (spec §1.4, §18).
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import Tag from "../components/ui/Tag.astro";
import Stat from "../components/ui/Stat.astro";
import Todo from "../components/ui/Todo.astro";
import Button from "../components/ui/Button.astro";
import CollaborateBand from "../components/CollaborateBand.astro";
import logo from "../assets/logo.png";
import uopLogo from "../assets/UOP_logo.png";
import { site, statements, disciplines, ecosystem, leadership } from "../data/site";
import { getResearchAreas } from "../lib/research";
import { getAllPublications } from "../lib/publications";
import { isPast } from "../lib/people";

const [projects, publications, people] = await Promise.all([
    getCollection("projects"),
    getAllPublications(),
    getCollection("people"),
]);
const stats = [
    { value: getResearchAreas().length, label: "Research areas" },
    { value: projects.length, label: "Research projects" },
    { value: publications.length, label: "Listed publications" },
    { value: people.filter((p) => !isPast(p)).length, label: "Current members" },
];

// Link leadership names to published profiles where one exists.
const norm = (n: string) =>
    n
        .toLowerCase()
        .replace(/\b(prof|dr|ir)\.?\s/g, "")
        .replace(/[^a-z]/g, "");
const profileFor = (name: string) =>
    people.find((p) => [p.data.name, ...p.data.otherNames].some((n) => norm(n) === norm(name)));
const initials = (name: string) =>
    name
        .replace(/\b(Prof|Dr|Ir)\.?\s/g, "")
        .split(/\s+/)
        .filter(Boolean)
        .map((w) => w[0])
        .slice(-2)
        .join("");
const director = leadership.director;
const directorProfile = profileFor(director.name);
---

<BaseLayout
    title="About"
    description={site.description}
    width="full"
    breadcrumbs={[{ label: "About" }]}
    header={{ eyebrow: "About MARC", title: site.name, subtitle: site.description }}
>
    <!-- Who we are -->
    <section class="container-marc section-y">
        <div class="grid items-start gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
            <div>
                <h2 class="text-h2">Who we are</h2>
                {statements.about.map((p) => <p class="text-lede mt-5">{p}</p>)}
                <div class="mt-8 flex flex-wrap gap-3">
                    <Button href="/research/" icon="material-symbols:arrow-forward">Explore research areas</Button>
                    <Button href="/people/" variant="outline">Meet the people</Button>
                </div>
            </div>

            <aside class="affil card-surface" aria-label="Affiliation">
                <div class="affil__logos">
                    <Image src={logo} alt="MARC logo" width={192} height={192} class="affil__logo" />
                    <span class="affil__divider" aria-hidden="true"></span>
                    <Image src={uopLogo} alt="University of Peradeniya crest" width={300} class="affil__logo affil__logo--uop" />
                </div>
                <p class="text-h4 mt-6 font-semibold text-heading">A research centre of the {site.university}</p>
                <p class="mt-1 text-[0.9375rem]">{site.address}</p>
                <div class="mt-6 border-t border-line-soft pt-5">
                    <p class="text-sm font-semibold text-heading">Multidisciplinary by design</p>
                    <ul class="mt-3 flex flex-wrap gap-2">
                        {disciplines.map((d) => <li><Tag variant="outline">{d}</Tag></li>)}
                    </ul>
                </div>
            </aside>
        </div>
        <Todo ref="§1.5, §18" class="mt-8">
            Real photography of MARC's labs, team or events for this section (replaces the 9.6 MB about.gif from the mockup).
        </Todo>
    </section>

    <!-- Mission, vision, numbers -->
    <section class="bg-soft section-y" aria-labelledby="mission-vision">
        <div class="container-marc">
            <h2 id="mission-vision" class="text-h2">Mission and vision</h2>
            <div class="mt-8 grid gap-6 md:grid-cols-2">
                <article class="mv-card">
                    <span class="mv-card__icon"><Icon name="material-symbols:explore-outline" /></span>
                    <h3 class="text-h3 mt-5">Our mission</h3>
                    <p class="mt-2">{statements.mission}</p>
                </article>
                <article class="mv-card">
                    <span class="mv-card__icon mv-card__icon--red"><Icon name="material-symbols:visibility-outline" /></span>
                    <h3 class="text-h3 mt-5">Our vision</h3>
                    <p class="mt-2">{statements.vision}</p>
                </article>
            </div>

            <div class="stats-row mt-12">
                {stats.map((s) => <Stat value={s.value} label={s.label} />)}
            </div>
        </div>
    </section>

    <!-- Leadership -->
    <section class="container-marc section-y" aria-labelledby="leadership">
        <h2 id="leadership" class="text-h2">Leadership</h2>

        <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-14">
            <article class="director card-surface">
                <div class="director__avatar" aria-hidden="true">{initials(director.name)}</div>
                <div>
                    <Tag variant="red">Director</Tag>
                    <h3 class="text-h3 mt-3">
                        {
                            directorProfile ? (
                                <a href={`/people/${directorProfile.id}/`} class="hover:text-primary hover:underline">{director.name}</a>
                            ) : (
                                director.name
                            )
                        }
                    </h3>
                    <p class="mt-1 text-[0.9375rem] text-heading">{director.role}</p>
                    <p class="text-sm text-muted">{director.affiliation}</p>
                    <p class="mt-4">{director.note}</p>
                    <a href={director.linkedin} target="_blank" rel="noopener" class="link-arrow mt-4">
                        LinkedIn profile <Icon name="material-symbols:arrow-outward" />
                        <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                </div>
            </article>

            <div>
                <h3 class="text-h4">Deputy Directors</h3>
                <ul class="deputies mt-4">
                    {
                        leadership.deputies.map((d) => {
                            const profile = profileFor(d.name);
                            return (
                                <li>
                                    {profile ? (
                                        <a href={`/people/${profile.id}/`} class="deputy deputy--link">
                                            <span class="deputy__name">{d.name}</span>
                                            <span class="deputy__role">{d.portfolio}</span>
                                            <Icon name="material-symbols:chevron-right" class="deputy__chev" />
                                        </a>
                                    ) : (
                                        <div class="deputy">
                                            <span class="deputy__name">{d.name}</span>
                                            <span class="deputy__role">{d.portfolio}</span>
                                        </div>
                                    )}
                                </li>
                            );
                        })
                    }
                </ul>
                <Todo ref="§7.2, §18" class="mt-6">
                    Signed message from the Director. Until it arrives, do not present placeholder text as the
                    Director's own words. Also needed: a Director photograph of at least 800 px.
                </Todo>
            </div>
        </div>
    </section>

    <!-- Research ecosystem -->
    <section id="ecosystem" class="bg-soft section-y" aria-labelledby="ecosystem-title">
        <div class="container-marc">
            <p class="eyebrow mb-2">Research ecosystem</p>
            <h2 id="ecosystem-title" class="text-h2">From research to societal impact</h2>

            <ol class="eco mt-10">
                {
                    ecosystem.steps.map((s, i) => (
                        <li class="eco__step">
                            <div class="eco__head">
                                <span class="eco__icon">
                                    <Icon name={s.icon} />
                                </span>
                                <span class="eco__num">Step {i + 1}</span>
                            </div>
                            <h3 class="text-h4 mt-4">{s.title}</h3>
                            <p class="mt-1 text-[0.9375rem]">{s.text}</p>
                        </li>
                    ))
                }
            </ol>

            <ul class="mt-6 grid gap-6 lg:grid-cols-3">
                {
                    ecosystem.notes.map((n) => (
                        <li class="note card-surface">
                            <Icon name={n.icon} class="note__icon" />
                            <h3 class="text-h4 mt-3">{n.title}</h3>
                            <p class="mt-1 text-[0.9375rem]">{n.text}</p>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- Advisors & initiatives -->
    <section class="container-marc section-y">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div>
                <h2 class="text-h2">Advisors</h2>
                <p class="mt-2 text-muted">International advisors and their institutions.</p>
                <ul class="list mt-6">
                    {
                        leadership.advisors.map((a) => (
                            <li class="list__row">
                                <span class="list__icon">
                                    <Icon name="material-symbols:account-balance-outline" />
                                </span>
                                <span>
                                    <span class="block font-semibold text-heading">{a.name}</span>
                                    {a.affiliation && <span class="block text-sm text-muted">{a.affiliation}</span>}
                                </span>
                            </li>
                        ))
                    }
                </ul>
            </div>
            <div>
                <h2 class="text-h2">Initiatives</h2>
                <p class="mt-2 text-muted">Related work linked to the centre.</p>
                <ul class="list mt-6">
                    <li>
                        <a href="/research/generative-ai/" class="list__row list__row--link">
                            <span class="list__icon">
                                <Icon name="material-symbols:workspace-premium-outline" />
                            </span>
                            <span class="flex-1">
                                <span class="block font-semibold text-heading">Heritage AI — NVIDIA Academic Grant</span>
                                <span class="block text-sm text-muted">Restoring and colorizing degraded historical images with implicit neural representations and diffusion models</span>
                            </span>
                            <Icon name="material-symbols:chevron-right" class="list__end" />
                        </a>
                    </li>
                    <li>
                        <a href="/projects/demographic_analysis/" class="list__row list__row--link">
                            <span class="list__icon">
                                <Icon name="material-symbols:verified-outline" />
                            </span>
                            <span class="flex-1">
                                <span class="block font-semibold text-heading">AI4Covid — IDRC grant</span>
                                <span class="block text-sm text-muted">Demographic analysis of population structure and health outcomes</span>
                            </span>
                            <Icon name="material-symbols:chevron-right" class="list__end" />
                        </a>
                    </li>
                </ul>

            </div>
        </div>
    </section>

    <CollaborateBand />
</BaseLayout>

<style>
    .affil {
        padding: clamp(1.5rem, 3vw, 2rem);
    }
    .affil__logos {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }
    .affil :global(.affil__logo) {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 0 0 1px var(--color-line);
        background: #fff;
    }
    .affil :global(.affil__logo--uop) {
        box-shadow: none;
        background: transparent;
    }
    .affil__divider {
        width: 1px;
        height: 56px;
        background: var(--color-line);
    }

    .mv-card {
        padding: clamp(1.5rem, 3vw, 2rem);
        border-radius: var(--radius-card);
        background: var(--color-base-100);
    }
    :global([data-theme="marc-dark"]) .mv-card {
        background: var(--color-soft-2);
    }
    .mv-card__icon {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--tint);
        color: var(--tint-content);
    }
    .mv-card__icon--red {
        background: var(--tint-red);
        color: var(--tint-red-content);
    }
    .mv-card__icon :global(svg) {
        width: 1.5rem;
        height: 1.5rem;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--color-line);
    }
    .stats-row > :global(*) {
        padding: 1.5rem 1.5rem 0 0;
    }
    .stats-row > :global(* + *) {
        padding-left: 1.5rem;
        border-left: 1px solid var(--color-line);
    }
    @media (max-width: 768px) {
        .stats-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .stats-row > :global(:nth-child(3)) {
            padding-left: 0;
            border-left: 0;
        }
    }

    .director {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.5rem;
        align-items: start;
        padding: clamp(1.5rem, 3vw, 2rem);
    }
    .director__avatar {
        display: grid;
        place-items: center;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: var(--tint);
        color: var(--tint-content);
        font-family: var(--font-head);
        font-weight: 600;
        font-size: 1.5rem;
    }
    @media (max-width: 480px) {
        .director {
            grid-template-columns: 1fr;
        }
    }

    .deputies {
        border-top: 1px solid var(--color-line);
    }
    .deputy {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        column-gap: 1rem;
        padding: 0.875rem 0.5rem;
        border-bottom: 1px solid var(--color-line);
    }
    .deputy__name {
        font-weight: 600;
        color: var(--color-heading);
    }
    .deputy__role {
        grid-column: 1;
        font-size: 0.875rem;
        color: var(--color-muted);
    }
    .deputy :global(.deputy__chev) {
        grid-column: 2;
        grid-row: 1 / span 2;
        width: 1.25rem;
        height: 1.25rem;
        color: var(--color-muted);
    }
    .deputy--link {
        transition: background-color var(--t-fast);
    }
    .deputy--link:hover {
        background: var(--state);
    }
    .deputy--link:hover .deputy__name {
        color: var(--color-primary);
    }

    .eco {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1.5rem;
    }
    .eco__step {
        padding: 1.5rem;
        border-radius: var(--radius-card);
        background: var(--color-base-100);
    }
    :global([data-theme="marc-dark"]) .eco__step {
        background: var(--color-soft-2);
    }
    .eco__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .eco__icon {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--tint);
        color: var(--tint-content);
    }
    .eco__icon :global(svg) {
        width: 1.375rem;
        height: 1.375rem;
    }
    .eco__num {
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-muted);
    }
    @media (max-width: 1080px) {
        .eco {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (max-width: 600px) {
        .eco {
            grid-template-columns: 1fr;
        }
    }
    .note {
        padding: 1.5rem;
    }
    .note :global(.note__icon) {
        width: 1.5rem;
        height: 1.5rem;
        color: var(--color-primary);
    }

    .list {
        border-top: 1px solid var(--color-line);
    }
    .list__row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0.5rem;
        border-bottom: 1px solid var(--color-line);
    }
    .list__row--link {
        transition: background-color var(--t-fast);
    }
    .list__row--link:hover {
        background: var(--state);
    }
    .list__icon {
        display: grid;
        place-items: center;
        flex: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--color-soft-2);
        color: var(--color-body);
    }
    .list__icon :global(svg) {
        width: 1.25rem;
        height: 1.25rem;
    }
    .list__row :global(.list__end) {
        width: 1.25rem;
        height: 1.25rem;
        color: var(--color-muted);
    }
</style>
