---
// Home (spec §7.1): hero + collage, research areas, highlights, featured projects, news, collaborate.
// The AI-generated hero illustration is retired (spec B13, §18).
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchAreaCard from "../components/ResearchAreaCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CollaborateBand from "../components/CollaborateBand.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Stat from "../components/ui/Stat.astro";
import Icon from "../components/ui/Icon.astro";
import Todo from "../components/ui/Todo.astro";
import HeroCollage from "../components/home/HeroCollage.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getResearchAreas } from "../lib/research";
import { getAllPublications, publicationsForProject } from "../lib/publications";
import { isPast } from "../lib/people";
import { getHomePhotos } from "../lib/homePhotos";
import { site, highlights } from "../data/site";

const researchAreas = getResearchAreas();

// Optional landing-page photos in src/assets/home/ (see homePhotos in src/data/site.ts).
const hasPhotos = getHomePhotos().length > 0;
const showMediaColumn = hasPhotos || import.meta.env.DEV;

const latestNews = (await getCollection("news"))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);

const [projects, publications, people] = await Promise.all([
    getCollection("projects"),
    getAllPublications(),
    getCollection("people"),
]);
const stats = [
    { label: "Research areas", value: researchAreas.length },
    // Spec B13: no status field yet, so this counts every listed project.
    { label: "Research projects", value: projects.length },
    { label: "Publications", value: publications.length },
    { label: "Researchers", value: people.filter((p) => !isPast(p)).length },
];

const projectCount = (title: string) => projects.filter((p) => p.data.researchArea === title).length;

// Featured projects: the six with the most listed publications.
const withPapers = await Promise.all(projects.map(async (p) => ({ p, n: (await publicationsForProject(p)).length })));
const featured = withPapers
    .sort((a, b) => b.n - a.n || a.p.data.project.localeCompare(b.p.data.project))
    .slice(0, 6);

// Highlights link to their project when that page exists, otherwise to the research area.
const projectIds = new Set(projects.map((p) => p.id));
const highlightCards = highlights.map((h) => {
    const area = researchAreas.find((a) => a.slug === h.area);
    const href = h.project && projectIds.has(h.project) ? `/projects/${h.project}/` : (area?.url ?? "/research/");
    return { ...h, href, accent: area?.accent ?? "blue" };
});
---

<BaseLayout title={site.name} description={site.description} width="full">
    <section class="hero">
        <div class="container-marc">
            <div class:list={["hero__grid", showMediaColumn && "hero__grid--media"]}>
                <div>
                    <p class="eyebrow mb-4">{site.university} · Faculty of Engineering</p>
                    <h1 class="hero__title text-h1 max-w-4xl">Multidisciplinary AI research for a human future</h1>
                    <p class="text-lede mt-6 max-w-2xl">
                        MARC brings together engineers, scientists and clinicians to build AI systems that are useful,
                        trustworthy, and grounded in real-world problems — from healthcare to smart grids.
                    </p>
                    <div class="mt-9 flex flex-wrap gap-3">
                        <Button href="/research/" icon="material-symbols:arrow-forward">Explore research</Button>
                        <Button href="/projects/" variant="outline">View projects</Button>
                    </div>
                </div>

                <div class="hero__media">
                    <span class="dot-field hero__dots hero__dots--a" aria-hidden="true"></span>
                    <span class="dot-field hero__dots hero__dots--b" aria-hidden="true"></span>
                    {
                        hasPhotos ? (
                            <HeroCollage />
                        ) : (
                            <Todo ref="§18" class="hero__placeholder">
                                Real photos of the MARC lab / interior for the landing page. Save 1–5 photos in
                                <code>src/assets/home/</code> (landscape, at least 1600 px wide, named 01-…, 02-… for order)
                                and describe them in <code>homePhotos</code> in <code>src/data/site.ts</code>. Until then
                                the published site shows the text-only hero.
                            </Todo>
                        )
                    }
                </div>
            </div>

            <div class="hero__stats">
                {stats.map((s) => <Stat value={s.value} label={s.label} />)}
            </div>
        </div>
    </section>

    <div class="container-marc">
        <Section
            eyebrow="Research"
            title="Six research areas, one shared mission"
            description="Our work spans foundational AI and applied research across domains where intelligence meets impact."
            cta={{ href: "/research/", label: "All research areas" }}
        >
            <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 nav:grid-cols-3">
                {
                    researchAreas.map((a, i) => {
                        const n = projectCount(a.title);
                        return (
                            <li class="reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
                                <ResearchAreaCard
                                    title={a.title}
                                    href={a.url}
                                    image={a.cover}
                                    summary={a.short}
                                    icon={a.icon}
                                    accent={a.accent}
                                    meta={n > 0 ? `${n} ${n === 1 ? "project" : "projects"}` : undefined}
                                />
                            </li>
                        );
                    })
                }
            </ul>
        </Section>
    </div>

    <section class="highlights section-y" aria-labelledby="highlights-title">
        <div class="container-marc">
            <div class="mb-10 max-w-[720px]">
                <p class="eyebrow eyebrow--red mb-2">Highlights</p>
                <h2 id="highlights-title" class="text-h2">Recognition, grants and collaborations</h2>
                <p class="text-lede mt-3">Milestones from across MARC's research programme.</p>
            </div>
            <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 nav:grid-cols-3">
                {
                    highlightCards.map((h, i) => (
                        <li class="reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
                            <a href={h.href} class:list={["highlight group", `acc-${h.accent}`]}>
                                <span class="acc-chip">
                                    <Icon name={h.icon} />
                                </span>
                                <p class="highlight__kicker">{h.kicker}</p>
                                <h3 class="text-h4 mt-1">{h.title}</h3>
                                <p class="mt-2 text-[0.9375rem]">{h.text}</p>
                                <span class="link-arrow mt-auto pt-5">
                                    Learn more <Icon name="material-symbols:arrow-forward" />
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <div class="container-marc">
        {
            featured.length > 0 && (
                <Section
                    eyebrow="Projects"
                    title="Featured projects"
                    description="The projects with the most published and accepted work."
                    cta={{ href: "/projects/", label: `All ${projects.length} projects` }}
                >
                    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 nav:grid-cols-3">
                        {featured.map(({ p, n }, i) => (
                            <li class="reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
                                <ProjectCard project={p} papers={n} />
                            </li>
                        ))}
                    </ul>
                </Section>
            )
        }

        <Section
            eyebrow="News"
            title="Latest from MARC"
            description="Awards, papers, talks and stories from the centre."
            cta={{ href: "/news/", label: "All news" }}
            class="border-t border-line-soft"
        >
            <ul class="grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-2 nav:grid-cols-3">
                {
                    latestNews.map((item, i) => (
                        <li class="reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
                            <a href={`/news/${item.id}/`} class="news-tile group">
                                <div class="news-tile__media">
                                    {item.data.cover && (
                                        <Image
                                            src={item.data.cover}
                                            alt=""
                                            widths={[400, 640, 800]}
                                            sizes="(max-width: 768px) 100vw, (max-width: 1080px) 50vw, 420px"
                                            class="news-tile__img"
                                        />
                                    )}
                                </div>
                                <time datetime={item.data.date.toISOString().slice(0, 10)} class="mt-4 block text-sm text-muted">
                                    {item.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
                                </time>
                                <h3 class="text-h3 mt-1 group-hover:text-primary group-hover:underline group-hover:underline-offset-4">
                                    {item.data.title}
                                </h3>
                                <p class="mt-2 line-clamp-2 text-[0.9375rem]">{item.data.short}</p>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </Section>
    </div>

    <CollaborateBand />
</BaseLayout>

<style>
    .hero {
        padding-block: clamp(40px, 6vw, 88px) clamp(40px, 5vw, 72px);
        border-bottom: 1px solid var(--color-line-soft);
        overflow: hidden;
    }
    .hero__grid {
        display: grid;
        gap: clamp(2rem, 4vw, 4rem);
        align-items: center;
    }
    @media (min-width: 1024px) {
        .hero__grid--media {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        }
        .hero__grid--media .hero__title {
            font-size: clamp(2.5rem, 2.4vw + 1.1rem, 3.75rem);
        }
    }
    .hero__media {
        position: relative;
        isolation: isolate;
    }
    .hero__dots {
        z-index: -1;
        display: none;
    }
    .hero__dots--a {
        top: -28px;
        right: -28px;
        width: 162px;
        height: 126px;
        color: var(--color-primary);
        opacity: 0.35;
    }
    .hero__dots--b {
        bottom: -28px;
        left: -28px;
        width: 126px;
        height: 90px;
        color: var(--color-secondary);
        opacity: 0.3;
    }
    @media (min-width: 1024px) {
        .hero__grid--media .hero__dots {
            display: block;
        }
    }
    .hero :global(.hero__placeholder) {
        display: grid;
        place-content: center;
        aspect-ratio: 4 / 3;
        border-radius: var(--radius-panel);
        text-align: center;
        padding: 2rem;
    }
    .hero :global(.hero__placeholder code) {
        font-size: 0.85em;
        font-weight: 600;
    }
    .hero__stats {
        margin-top: clamp(48px, 6vw, 80px);
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--color-line);
    }
    .hero__stats > :global(*) {
        padding: 1.5rem 1.5rem 0 0;
    }
    .hero__stats > :global(* + *) {
        padding-left: 1.5rem;
        border-left: 1px solid var(--color-line);
    }
    .hero__stats :global(.stat__value) {
        color: var(--color-primary);
    }
    @media (max-width: 768px) {
        .hero__stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .hero__stats > :global(:nth-child(3)) {
            padding-left: 0;
            border-left: 0;
        }
    }

    .highlights {
        background: var(--color-surface-tint);
    }
    .highlight {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 1.75rem;
        border-radius: var(--radius-card);
        background: var(--color-base-100);
        transition:
            box-shadow var(--t) var(--ease-brand),
            transform var(--t) var(--ease-brand);
    }
    :global([data-theme="marc-dark"]) .highlight {
        background: var(--color-soft);
    }
    .highlight:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }
    .highlight__kicker {
        margin-top: 1.25rem;
        font-family: var(--font-head);
        font-weight: 700;
        font-size: clamp(1.375rem, 0.8vw + 1.1rem, 1.75rem);
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--acc);
    }

    .news-tile {
        display: block;
    }
    .news-tile__media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 16px;
        background: var(--color-soft-2);
    }
    .news-tile :global(.news-tile__img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--t-slow) var(--ease-brand);
    }
    .news-tile:hover :global(.news-tile__img) {
        transform: scale(1.04);
    }
</style>
