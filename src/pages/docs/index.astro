---
// Documentation hub: how MARC members keep the website's content up to date (see DocsLayout).
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/ui/Icon.astro";
import { docs, contentRepos, site } from "../../data/site";

const where = [
    { what: "People profiles", place: "marc_people repository, profiles/ folder", href: contentRepos.people, guide: "/docs/profiles/" },
    { what: "Projects", place: "marc_projects repository, projects/ folder", href: contentRepos.projects, guide: "/docs/projects/" },
    { what: "News articles and vacancies", place: "marc_news repository, articles/ folder", href: contentRepos.news, guide: "/docs/news/" },
    { what: "Social feed items", place: "Website data Google Sheet, News tab", guide: "/docs/news/#social-feed-items" },
    { what: "Publications", place: "MARC Publications Google Sheet, one tab per project", guide: "/docs/publications/" },
    { what: "Home photos, research areas, highlights, contact details", place: "Website repository", href: contentRepos.website, guide: "/docs/site/" },
];

// Changes that span repositories, as checklists.
const tasks = [
    {
        title: "A new member joins MARC and a project",
        steps: [
            { where: "marc_people", href: "/docs/profiles/#add-a-new-profile", text: "add their profile, with their email and name, plus any other addresses (otherEmails) and the forms of their name used in their papers (otherNames)." },
            { where: "marc_projects", href: "/docs/profiles/#add-yourself-to-your-projects", text: "add the same email to each project they work on." },
            { where: "Their papers", href: "/docs/publications/#linking-papers-to-people", text: "check each paper appears on their profile; if not, add the author-list form of their name to otherNames." },
        ],
    },
    {
        title: "Someone joins or leaves a project",
        steps: [
            { where: "marc_projects", href: "/docs/projects/#adding-or-removing-a-team-member", text: "add or remove their email in the project's projectMembers or supervisors. Their profile does not change." },
        ],
    },
    {
        title: "Someone's email address changes",
        steps: [
            { where: "marc_people", href: "/docs/profiles/#changing-your-email-or-name", text: "put the new address in email and move the old one to otherEmails. Project files stay as they are." },
        ],
    },
    {
        title: "Someone leaves MARC",
        steps: [
            { where: "marc_people", href: "/docs/profiles/#when-you-leave-marc", text: "set status: past and, if known, currentPosition. Don't delete the profile." },
            { where: "marc_projects", href: "/docs/profiles/#when-you-leave-marc", text: "nothing to change: they stay on their projects, marked as a past member." },
        ],
    },
    {
        title: "A new paper is published",
        steps: [
            { where: "Publications sheet", href: "/docs/publications/#columns", text: "add a row in the project's tab, with the DOI and authors' full names. Copy the row to other projects' tabs if it belongs to several." },
        ],
    },
    {
        title: "A project is renamed",
        steps: [
            { where: "marc_projects", href: "/docs/projects/#changing-a-linking-key-safely", text: "rename the file (the page address changes)." },
            { where: "Publications sheet", href: "/docs/publications/#linking-papers-to-a-project", text: "rename the project's tab to match." },
            { where: "Website", href: "/docs/site/", text: "ask a maintainer to update highlights and projectPublicationTabs." },
        ],
    },
];

// Values written in two places that must stay identical (see each guide's "Linking keys" box).
const keys = [
    {
        key: "email + otherEmails",
        in: "Profile",
        match: "projectMembers / supervisors in project files",
        connects: "A person ↔ their projects",
        change: "Move the old address to otherEmails and every project keeps linking.",
        guide: "/docs/profiles/#changing-your-email-or-name",
    },
    {
        key: "name + otherNames",
        in: "Profile",
        match: "Authors column of the publications sheet",
        connects: "A person ↔ their publications",
        change: "Move the old form to otherNames and every paper stays on the profile.",
        guide: "/docs/profiles/#changing-your-email-or-name",
    },
    {
        key: "File name",
        in: "Project",
        match: "The project's tab in the publications sheet; highlights in site.ts",
        connects: "A project ↔ its publications; the page address",
        change: "Publications drop off and the address changes. Rename the tab too.",
        guide: "/docs/projects/#changing-a-linking-key-safely",
    },
    {
        key: "researchArea",
        in: "Project",
        match: "One of the six research area names",
        connects: "A project ↔ its research area page",
        change: "Must stay one of the six names, spelled exactly.",
        guide: "/docs/projects/#fields",
    },
    {
        key: "DOI / title",
        in: "Publications sheet",
        match: "The same paper in another tab",
        connects: "One paper ↔ several projects",
        change: "The paper is listed twice. Copy rows instead of retyping them.",
        guide: "/docs/publications/",
    },
    {
        key: "File name",
        in: "News article",
        match: "Links shared outside the site",
        connects: "The article's page address",
        change: "Shared links stop working. Don't rename after publishing.",
        guide: "/docs/news/",
    },
];
---

<BaseLayout
    title="Documentation"
    description="How MARC members keep the website's profiles, projects, news and publications up to date."
    noindex
    breadcrumbs={[{ label: "Documentation" }]}
    header={{
        eyebrow: "For MARC members",
        title: "Documentation",
        subtitle: "How to keep the website's profiles, projects, news and publications up to date.",
    }}
>
    <ul class="guides">
        {
            docs.map((d) => (
                <li>
                    <a href={d.href} class="guide card-surface surface-hover">
                        <span class="guide__icon">
                            <Icon name={d.icon} />
                        </span>
                        <h2 class="text-h4 mt-4">{d.label}</h2>
                        <p class="mt-1 text-[0.9375rem]">{d.text}</p>
                        <span class="link-arrow mt-auto pt-4 text-sm">
                            Read the guide <Icon name="material-symbols:arrow-forward" />
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>

    <section class="mt-16" aria-labelledby="tasks">
        <h2 id="tasks" class="text-h3">Common tasks</h2>
        <p class="mt-2 max-w-3xl">
            Some changes touch more than one place. Do every step, or a link between the pages will be missing.
        </p>
        <ul class="tasks mt-6">
            {
                tasks.map((t) => (
                    <li class="task card-surface">
                        <h3 class="text-h4">{t.title}</h3>
                        <ol class="task__steps">
                            {t.steps.map((s) => (
                                <li>
                                    <a href={s.href} class="text-primary underline underline-offset-2">{s.where}</a>: {s.text}
                                </li>
                            ))}
                        </ol>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="mt-16" aria-labelledby="keys">
        <h2 id="keys" class="text-h3">How content is linked</h2>
        <p class="mt-2 max-w-3xl">
            Profiles, projects and publications are connected by a few <b>linking keys</b>: values that must be written
            exactly the same in two places. Everything else can be edited freely. Before changing a key, update the other
            side too, or the link silently disappears.
        </p>
        <div class="table-wrap card-surface mt-6">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Linking key</th>
                        <th scope="col">Must match</th>
                        <th scope="col">What it connects</th>
                        <th scope="col">If it changes</th>
                    </tr>
                </thead>
                <tbody>
                    {
                        keys.map((k) => (
                            <tr>
                                <th scope="row">
                                    <span class="key-chip">
                                        <Icon name="material-symbols:key-outline" />
                                        {k.key}
                                    </span>
                                    <span class="mt-1 block text-sm font-normal text-muted">{k.in}</span>
                                </th>
                                <td>{k.match}</td>
                                <td>{k.connects}</td>
                                <td>
                                    {k.change}{" "}
                                    <a href={k.guide} class="text-primary underline underline-offset-2">
                                        How<span class="sr-only"> to change {k.key} safely</span>
                                    </a>
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="mt-16" aria-labelledby="where">
        <h2 id="where" class="text-h3">What is edited where</h2>
        <div class="table-wrap card-surface mt-6">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Content</th>
                        <th scope="col">Edited in</th>
                        <th scope="col"><span class="sr-only">Guide</span></th>
                    </tr>
                </thead>
                <tbody>
                    {
                        where.map((w) => (
                            <tr>
                                <th scope="row">{w.what}</th>
                                <td>
                                    {w.href ? (
                                        <a href={w.href} target="_blank" rel="noopener" class="text-primary hover:underline">
                                            {w.place}
                                            <span class="sr-only"> (opens in a new tab)</span>
                                        </a>
                                    ) : (
                                        w.place
                                    )}
                                </td>
                                <td>
                                    <a href={w.guide} class="link-arrow text-sm whitespace-nowrap">
                                        Guide<span class="sr-only"> for {w.what.toLowerCase()}</span>
                                        <Icon name="material-symbols:arrow-forward" />
                                    </a>
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="steps-panel surface-tonal mt-16" aria-labelledby="live">
        <h2 id="live" class="text-h3">How changes go live</h2>
        <ol class="steps-panel__list mt-6">
            <li>
                <span class="steps-panel__num" aria-hidden="true">1</span>
                <div>
                    <h3 class="text-h4">Edit on GitHub</h3>
                    <p class="mt-1">
                        Open the file in the repository and click the pencil icon (or <b>Add file</b> for a new one). If you
                        are not a member of the repository, GitHub forks it for you.
                    </p>
                </div>
            </li>
            <li>
                <span class="steps-panel__num" aria-hidden="true">2</span>
                <div>
                    <h3 class="text-h4">Open a pull request</h3>
                    <p class="mt-1">
                        Commit to a new branch and open a pull request. An automatic check validates the front matter; if it
                        fails, its message says which file and field to fix.
                    </p>
                </div>
            </li>
            <li>
                <span class="steps-panel__num" aria-hidden="true">3</span>
                <div>
                    <h3 class="text-h4">Merge and rebuild</h3>
                    <p class="mt-1">
                        When a MARC maintainer merges the pull request, the website rebuilds automatically and your change goes
                        live when the rebuild finishes.
                    </p>
                </div>
            </li>
        </ol>
        <p class="mt-8 text-[0.9375rem]">
            Google Sheet changes (publications, social feed) are picked up at the next rebuild. Need edit access to a sheet or
            repository? Email <a href={`mailto:${site.email}`} class="text-primary underline">{site.email}</a>.
        </p>
    </section>
</BaseLayout>

<style>
    .guides {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    }
    .guide {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 1.5rem;
    }
    .guide__icon {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--tint);
        color: var(--tint-content);
    }
    .guide__icon :global(svg) {
        width: 1.5rem;
        height: 1.5rem;
    }
    .tasks {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    }
    .task {
        padding: 1.25rem 1.5rem;
    }
    .task__steps {
        margin-top: 0.75rem;
        padding-left: 1.25rem;
        list-style: decimal;
        display: grid;
        gap: 0.5rem;
        font-size: 0.9375rem;
    }
    .task__steps li::marker {
        color: var(--color-muted);
        font-weight: 600;
    }
    .table-wrap {
        /* relative: keeps the absolutely positioned sr-only text inside the scroll box on phones */
        position: relative;
        overflow-x: auto;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9375rem;
    }
    th,
    td {
        padding: 0.875rem 1.25rem;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid var(--color-line-soft);
    }
    tbody tr:last-child > * {
        border-bottom: 0;
    }
    thead th {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-muted);
        background: var(--color-soft);
    }
    tbody th {
        font-weight: 600;
        color: var(--color-heading);
    }
    .key-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        white-space: nowrap;
        font-family: var(--font-mono, ui-monospace, monospace);
        font-size: 0.875rem;
    }
    .key-chip :global(svg) {
        width: 1rem;
        height: 1rem;
        flex: none;
        color: var(--color-accent);
    }
    .steps-panel {
        padding: clamp(1.5rem, 5vw, 3rem);
    }
    .steps-panel__list {
        display: grid;
        gap: 1.5rem;
    }
    @media (min-width: 900px) {
        .steps-panel__list {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    .steps-panel__list li {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }
    .steps-panel__num {
        display: grid;
        place-items: center;
        flex: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--color-primary);
        color: var(--color-primary-content);
        font-family: var(--font-head);
        font-weight: 600;
    }
</style>
