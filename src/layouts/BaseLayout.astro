---
import "@fontsource-variable/inter";
import "@fontsource-variable/manrope";
import "@fontsource/barlow-condensed/500.css";
import "@fontsource/barlow-condensed/600.css";
import "../styles/app.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import barlowLatin from "@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url";
import { getImage } from "astro:assets";
import logo from "../assets/logo.png";
import Topbar from "../components/layout/Topbar.astro";
import Header from "../components/layout/Header.astro";
import ScrollProgress from "../components/layout/ScrollProgress.astro";
import Footer from "../components/layout/Footer.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Breadcrumb, { type Crumb } from "../components/ui/Breadcrumb.astro";
import { site, socials } from "../data/site";

interface Props {
    title?: string;
    description?: string;
    /** Path or absolute URL of a 1200×630 share image. */
    image?: string;
    /** Content width: "default" (1280), "narrow" (900), "wide" (1480) or "full" (no wrapper). */
    width?: "default" | "narrow" | "wide" | "full";
    /** @deprecated use width="full" */
    fullWidth?: boolean;
    /** Trail after "Home". Rendered inside the page header when `header` is set. */
    breadcrumbs?: Crumb[];
    /** Renders the shared PageHeader band (and the page's H1). */
    header?: {
        eyebrow?: string;
        eyebrowTone?: "default" | "red";
        title: string;
        subtitle?: string;
        align?: "left" | "center";
    };
    /** Extra JSON-LD objects for this page. */
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
    ogType?: "website" | "article" | "profile";
    noindex?: boolean;
}

const HOME_TITLE = site.name;
const {
    title = HOME_TITLE,
    description = "MARC — the Multidisciplinary AI Research Centre at the Faculty of Engineering, University of Peradeniya, Sri Lanka.",
    image = "/og-default.png",
    width: widthProp,
    fullWidth = false,
    breadcrumbs,
    header,
    jsonLd,
    ogType = "website",
    noindex = false,
} = Astro.props;

const width = widthProp ?? (fullWidth ? "full" : "default");
const fullTitle = title === HOME_TITLE ? `${site.name} | ${site.university}` : `${title} — MARC`;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

const [favicon32, favicon192, appleTouch, logo512] = await Promise.all([
    getImage({ src: logo, width: 32, height: 32, format: "png" }),
    getImage({ src: logo, width: 192, height: 192, format: "png" }),
    getImage({ src: logo, width: 180, height: 180, format: "png" }),
    getImage({ src: logo, width: 512, height: 512, format: "png" }),
]);

const organization = {
    "@context": "https://schema.org",
    "@type": "ResearchOrganization",
    name: site.name,
    alternateName: site.shortName,
    url: siteUrl.href,
    logo: new URL(logo512.src, siteUrl).href,
    email: site.email,
    parentOrganization: {
        "@type": "CollegeOrUniversity",
        name: site.university,
        url: site.universityUrl,
    },
    address: {
        "@type": "PostalAddress",
        streetAddress: "Faculty of Engineering, University of Peradeniya",
        addressLocality: "Peradeniya",
        addressCountry: "LK",
    },
    sameAs: socials.map((s) => s.href),
};
const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const wrapper = {
    default: "container-marc",
    narrow: "container-narrow",
    wide: "container-wide",
    full: "",
}[width];
---

<!doctype html>
<html lang="en" data-theme="marc">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex" />}
        <meta name="theme-color" content="#0a76a4" />
        <meta name="color-scheme" content="light dark" />

        <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
        <link rel="icon" type="image/png" sizes="192x192" href={favicon192.src} />
        <link rel="apple-touch-icon" href={appleTouch.src} />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={barlowLatin} as="font" type="font/woff2" crossorigin />

        <!-- Open Graph / Twitter -->
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="en_US" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <script type="application/ld+json" set:html={JSON.stringify(organization)} />
        {pageLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

        <!-- JS flag + theme bootstrap (runs before paint: no dark-mode flash) -->
        <script is:inline>
            (() => {
                const root = document.documentElement;
                root.classList.add("js");
                try {
                    const stored = localStorage.getItem("marc-theme");
                    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
                    root.setAttribute("data-theme", stored || (prefersDark ? "marc-dark" : "marc"));
                } catch (_) {}
            })();
        </script>
    </head>
    <body class="flex flex-col min-h-screen bg-base-100">
        <a href="#main" class="skip-link">Skip to main content</a>
        <ScrollProgress />
        <Topbar />
        <Header />

        <main id="main" tabindex="-1" class="flex-grow focus:outline-none">
            {
                header && (
                    <PageHeader
                        eyebrow={header.eyebrow}
                        eyebrowTone={header.eyebrowTone}
                        title={header.title}
                        subtitle={header.subtitle}
                        align={header.align}
                        breadcrumbs={breadcrumbs}
                    />
                )
            }
            {
                width === "full" ? (
                    <slot />
                ) : (
                    <div class:list={[wrapper, header ? "pt-10 pb-20 lg:pt-14 lg:pb-24" : "pt-6 pb-20 lg:pt-8 lg:pb-24"]}>
                        {!header && breadcrumbs && <Breadcrumb items={breadcrumbs} class="mb-8" />}
                        <slot />
                    </div>
                )
            }
        </main>

        <Footer />
    </body>
</html>

<style is:global>
    .skip-link {
        position: absolute;
        left: 16px;
        top: 12px;
        z-index: 2000;
        padding: 0.625rem 1.25rem;
        border-radius: 999px;
        background: var(--color-primary);
        color: var(--color-primary-content);
        font-weight: 600;
        font-size: 0.9375rem;
        transform: translateY(-160%);
        transition: transform var(--t-fast) var(--ease-brand);
    }
    .skip-link:focus,
    .skip-link:focus-visible {
        transform: translateY(0);
        outline: 3px solid #fff;
        outline-offset: 2px;
    }
</style>
